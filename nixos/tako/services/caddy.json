{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests/sec per host",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (host) (rate(caddy_http_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Response bytes/sec per host",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (host) (rate(caddy_http_response_size_bytes_sum[$__rate_interval]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency per host",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never"}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (host, le) (rate(caddy_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests/sec per host by status class",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "showPoints": "never", "stacking": {"mode": "normal"}}},
        "overrides": []
      },
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "expr": "sum by (host, code) (rate(caddy_http_request_duration_seconds_count{host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Top hosts (last range)",
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 18},
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "options": {"showHeader": true},
      "targets": [
        {
          "expr": "sort_desc(sum by (host) (increase(caddy_http_request_duration_seconds_count[$__range])))",
          "legendFormat": "{{host}}",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "instance": true, "machine": true, "service": true}, "renameByName": {"Value": "Requests", "host": "Host"}}}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["caddy", "per-host"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": "label_values(caddy_http_request_duration_seconds_count, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {"text": "All", "value": "$__all"},
        "label": "Host"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "title": "Caddy — per-host traffic",
  "uid": "caddy-per-host",
  "version": 1,
  "weekStart": ""
}
